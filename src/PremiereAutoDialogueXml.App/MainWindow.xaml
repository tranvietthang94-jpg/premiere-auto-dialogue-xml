<Window x:Class="PremiereAutoDialogueXml.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Premiere Auto Dialogue XML"
        Width="1100"
        Height="820"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE2E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="#2457D6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E9EDF3" />
            <Setter Property="Foreground" Value="#243247" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B42318" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#C8D0D9" />
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#152033"
                           Text="Premiere Auto Dialogue XML" />
                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#58667A" TextWrapping="Wrap"
                           Text="Tự động chuẩn bị line tiếng nghệ sĩ hoàn toàn offline, giữ nguyên XML, WAV và project Premiere gốc." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StepCard}">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#2457D6" FontWeight="Bold" Text="BƯỚC 1" />
                        <TextBlock Margin="0,5,0,4" FontSize="16" FontWeight="SemiBold" Text="Chọn XML" />
                        <TextBlock Foreground="#667386" TextWrapping="Wrap" Text="{Binding StepOneStatus}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StepCard}">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#2457D6" FontWeight="Bold" Text="BƯỚC 2" />
                        <TextBlock Margin="0,5,0,4" FontSize="16" FontWeight="SemiBold" Text="Kiểm tra" />
                        <TextBlock Foreground="#667386" TextWrapping="Wrap" Text="{Binding StepTwoStatus}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StepCard}">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#2457D6" FontWeight="Bold" Text="BƯỚC 3" />
                        <TextBlock Margin="0,5,0,4" FontSize="16" FontWeight="SemiBold" Text="Phân tích" />
                        <TextBlock Foreground="#667386" TextWrapping="Wrap" Text="{Binding StepThreeStatus}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StepCard}" Margin="0">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#2457D6" FontWeight="Bold" Text="BƯỚC 4" />
                        <TextBlock Margin="0,5,0,4" FontSize="16" FontWeight="SemiBold" Text="Xuất kết quả" />
                        <TextBlock Foreground="#667386" TextWrapping="Wrap" Text="{Binding StepFourStatus}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#DCE2E8" BorderThickness="1"
                    CornerRadius="12" Padding="22" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,18"
                               FontSize="18" FontWeight="SemiBold" Text="Chuẩn bị tệp" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="XML từ Premiere" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" IsReadOnly="True"
                             Text="{Binding XmlPath, Mode=OneWay}" ToolTip="Tệp XML đầu vào luôn được giữ nguyên" />
                    <Button Grid.Row="1" Grid.Column="2" Click="SelectXml_Click" Content="Chọn XML…"
                            IsEnabled="{Binding CanChooseFiles}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,14,0,0" VerticalAlignment="Center"
                               Text="Thư mục kết quả" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,14,12,0" IsReadOnly="True"
                             Text="{Binding OutputDirectory, Mode=OneWay}" ToolTip="Mỗi lần chạy sẽ tạo một thư mục mới" />
                    <Button Grid.Row="2" Grid.Column="2" Margin="0,14,0,0"
                            Click="SelectOutputDirectory_Click" Content="Chọn thư mục…"
                            IsEnabled="{Binding CanChooseFiles}" />

                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,18,0,0"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Foreground="#6A7586"
                                   Text="Chỉ đọc XML và header WAV; chưa quét âm thanh." />
                        <Button Click="InspectSelection_Click" Content="Kiểm tra XML và media"
                                IsEnabled="{Binding CanInspect}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="#EAF0FF" BorderBrush="#B9CAFA" BorderThickness="1"
                    CornerRadius="10" Padding="16" Margin="0,0,0,18">
                <TextBlock Foreground="#20345F" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>

            <Border Grid.Row="4" Background="White" BorderBrush="#DCE2E8" BorderThickness="1"
                    CornerRadius="12" Padding="22" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Phân tích và xuất XML" />
                            <TextBlock Margin="0,5,0,0" Foreground="#667386" TextWrapping="Wrap"
                                       Text="Preset Cân bằng · tối đa 4 worker · target sample peak -6 dBFS" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,10,0" Click="StartProcessing_Click"
                                    Content="Phân tích và xuất kết quả" IsEnabled="{Binding CanProcess}" />
                            <Button Style="{StaticResource DangerButton}" Click="CancelProcessing_Click"
                                    Content="Dừng an toàn" IsEnabled="{Binding CanCancel}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Grid.Row="1" Margin="0,18,0,7" Height="12" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Foreground="#58667A" TextWrapping="Wrap"
                               Text="{Binding ProgressMessage}" />

                    <Border Grid.Row="3" Margin="0,18,0,0" Padding="14" CornerRadius="8"
                            Background="#F7F9FB" BorderBrush="#E0E5EB" BorderThickness="1">
                        <TextBlock Text="{Binding OutputSummary}" TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox IsReadOnly="True" Text="{Binding OutputXmlPath, Mode=OneWay}"
                                 ToolTip="XML mới để import vào Premiere" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}"
                                Click="OpenOutput_Click" Content="Mở trong Explorer"
                                IsEnabled="{Binding CanOpenOutput}" />
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="5">
                <Expander Header="Chi tiết kỹ thuật" Background="White" BorderBrush="#DCE2E8"
                          BorderThickness="1" Padding="14">
                    <StackPanel Margin="4,8,4,4">
                        <TextBlock FontWeight="SemiBold" Text="Preset Cân bằng" />
                        <TextBlock Margin="0,5,0,0" Foreground="#58667A" TextWrapping="Wrap"
                                   Text="{Binding PresetSummary}" />
                        <TextBlock Margin="0,10,0,0" Foreground="#58667A" TextWrapping="Wrap"
                                   Text="Không cloud, không API, không telemetry. Sample peak -6 dBFS không phải LUFS, true peak hoặc cam kết Master bus." />
                        <Separator Margin="0,14,0,10" />
                        <TextBlock FontWeight="SemiBold" Text="Kiểm tra, warning và diagnostic" />
                        <TextBlock Margin="0,5,0,0" Foreground="#58667A" TextWrapping="Wrap"
                                   Text="{Binding InspectionDetails}" />
                    </StackPanel>
                </Expander>
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="#7A8594"
                           Text="Phase 05 · xử lý offline, luôn tạo XML/audit mới" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
